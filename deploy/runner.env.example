STRIX_RUNNER_TOKEN=change-before-start
STRIX_RUNNER_BIND=change-before-start
STRIX_RUNNER_PORT=8787
STRIX_DATA_DIR=/data
# If Docker runs outside the Runner container, set this to the host-visible
# path of the same volume mounted at STRIX_DATA_DIR.
STRIX_DOCKER_DATA_DIR=/var/lib/docker/volumes/strix-data/_data
STRIX_BINARY=strix
STRIX_SANDBOX_IMAGE=ghcr.io/usestrix/strix-sandbox:1.3.0
STRIX_LLM=deepseek/deepseek-v4-pro
LLM_API_KEY=change-before-start
STRIX_MAX_BUDGET_USD=5
STRIX_REPORT_RETENTION_DAYS=7
STRIX_ALLOWED_TARGETS=host.docker.internal:3001
